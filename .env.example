# cp this to .env and fill in your own values — .env is gitignored, never commit real keys.

# Required
X_BEARER_TOKEN=
ANTHROPIC_API_KEY=

# Only needed for live Coinbase trading (trading.enabled + dry_run: false in config.yaml).
# Leave blank to run the trader in dry-run, which sends no orders.
COINBASE_API_KEY=
COINBASE_API_SECRET=
